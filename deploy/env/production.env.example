# Copy to an untracked server-side file and fill secrets in the Laravel APP_ENV_FILE. Never commit the copy.
COMPOSE_PROJECT_NAME=rylay_production
APP_ENV_NAME=production
APP_HOSTNAME=admin.example.com
APP_HTTP_PORT=18081
MOBILE_APP_HOSTNAME=mobile.example.com
MOBILE_APP_HTTP_PORT=18083
RELEASE_ROOT=/srv/rylay/production
APP_ENV_FILE=/srv/rylay/production/shared/.env
PHP_FPM_IMAGE=rylay-php:8.4.21-1
DEPLOYMENT_MODE=prelaunch-production
COMMUNITY_DEVELOPER_NAME=RYLAY
DB_DATABASE=rylay_production
DB_USERNAME=rylay_production_app
COMMUNITY_TERMS_URL=https://app.example.com/legal/terms
COMMUNITY_PRIVACY_URL=https://app.example.com/legal/privacy
COMMUNITY_STANDARDS_URL=https://app.example.com/legal/community-standards
COMMUNITY_CHILD_SAFETY_URL=https://app.example.com/legal/child-safety
COMMUNITY_SUPPORT_URL=https://app.example.com/legal/support
COMMUNITY_SUPPORT_EMAIL=replace-with-monitored-support-address
CHILD_SAFETY_CONTACT_EMAIL=replace-with-monitored-child-safety-address
