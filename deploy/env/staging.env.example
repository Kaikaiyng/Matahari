# Copy to an untracked server-side file and fill secrets in the Laravel APP_ENV_FILE. Never commit the copy.
COMPOSE_PROJECT_NAME=rylay_staging
APP_ENV_NAME=staging
APP_HOSTNAME=staging.example.com
APP_HTTP_PORT=18080
MOBILE_APP_HOSTNAME=staging-app.example.com
MOBILE_APP_HTTP_PORT=18082
RELEASE_ROOT=/srv/rylay/staging
APP_ENV_FILE=/srv/rylay/staging/shared/.env
PHP_FPM_IMAGE=rylay-php:8.4.21-1
DEPLOYMENT_MODE=staging
TENANCY_MODE=dedicated
TENANCY_DEDICATED_TENANT_SLUG=mis
DB_DATABASE=matahari_staging
DB_USERNAME=matahari_staging_app

# Set these in the Laravel APP_ENV_FILE as well. Compose interpolation alone does not configure Laravel.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
