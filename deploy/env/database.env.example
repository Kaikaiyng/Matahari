# Copy to an untracked server-side file and fill secret file paths there. Never commit the copy.
STAGING_DB_DATABASE=rylay_staging
STAGING_DB_USERNAME=rylay_staging_app
STAGING_MIGRATOR_USERNAME=rylay_staging_migrator
PRODUCTION_DB_DATABASE=rylay_production
PRODUCTION_DB_USERNAME=rylay_production_app
PRODUCTION_MIGRATOR_USERNAME=rylay_production_migrator
MARIADB_ROOT_PASSWORD_FILE=/srv/rylay/secrets/mariadb-root-password
STAGING_APP_PASSWORD_FILE=/srv/rylay/secrets/staging-app-password
STAGING_MIGRATOR_PASSWORD_FILE=/srv/rylay/secrets/staging-migrator-password
PRODUCTION_APP_PASSWORD_FILE=/srv/rylay/secrets/production-app-password
PRODUCTION_MIGRATOR_PASSWORD_FILE=/srv/rylay/secrets/production-migrator-password
